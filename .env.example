# Copy to `.env` beside docker-compose.yml (never commit `.env`).

# ── GHCR image (lowercase path) ─────────────────────────────────────────────
# GHCR_IMAGE=ghcr.io/owner/telegramautodownload:latest
# GHCR_IMAGE=ghcr.io/owner/telegramautodownload:1.2.3

# ── Host paths (Compose bind mounts) ────────────────────────────────────────
# DATA_VOLUME=./data
# DOWNLOADS_VOLUME=./downloads
# Synology example:
# DATA_VOLUME=/volume1/docker/telegram-auto-download/data
# DOWNLOADS_VOLUME=/volume1/homes/work/telegram-downloads

# ── Published port on the host ──────────────────────────────────────────────
# HOST_PORT=8080

# ── Web dashboard login (change before exposing on your network) ────────────
WEB_USERNAME=admin
WEB_PASSWORD=changeme
WEB_AUTH_ENABLED=true
WEB_SESSION_DAYS=7
# Set true when the app is served only behind HTTPS (reverse proxy terminates TLS)
WEB_AUTH_SECURE_COOKIES=false

# ── Telegram API (https://my.telegram.org) — optional if set via web UI ─────
APP_ID=
API_HASH=

# ── Optional notification bot ───────────────────────────────────────────────
BOT_TOKEN=
CHAT_ID=

# ── Optional timezone (Linux TZ database name, e.g. Asia/Kolkata, Europe/Berlin)
TZ=
