# Copy to `.env` beside docker-compose.yml (never commit `.env`).
#
# Short names (WEB_*, APP_*) are mapped in compose to TELEGRAMDOWNLOAD_* inside the container.
# On a NAS you can skip this file and use only /data/secret.env with TELEGRAMDOWNLOAD_* keys instead.

# ── GHCR image ────────────────────────────────────────────────────────────────
# GHCR_IMAGE=ghcr.io/kesavananbu/telegramautodownload:latest
# GHCR_IMAGE=ghcr.io/kesavananbu/telegramautodownload:2.9.6

# ── Optional: path to shared secret.env (Compose env_file) ───────────────────
# SECRET_ENV_FILE=/data/secret.env

# ── Host paths (Compose bind mounts) ──────────────────────────────────────────
# DATA_VOLUME=./data
# DOWNLOADS_VOLUME=./downloads
# Synology example:
# DATA_VOLUME=/volume1/docker/telegram-auto-download/data
# DOWNLOADS_VOLUME=/volume1/homes/work/telegram-downloads

# ── Published port on the host ────────────────────────────────────────────────
# HOST_PORT=8080

# ── Web dashboard (compose substitutes into TELEGRAMDOWNLOAD_*) ─────────────
WEB_USERNAME=admin
WEB_PASSWORD=
WEB_AUTH_ENABLED=true
WEB_SESSION_DAYS=7
WEB_AUTH_SECURE_COOKIES=false
# WEB_PASSWORD_RESET=true
# WEB_AUTH_TRUSTED_PROXIES=

# ── Telegram API (https://my.telegram.org) — optional if set via web UI ─────
APP_ID=
API_HASH=

# ── Optional notification bot ─────────────────────────────────────────────────
BOT_TOKEN=
CHAT_ID=

# ── Shared secret.env (NAS / Portainer) — namespaced keys ───────────────────
# TELEGRAMDOWNLOAD_WEB_USERNAME=admin
# TELEGRAMDOWNLOAD_WEB_PASSWORD=
# TELEGRAMDOWNLOAD_WEB_AUTH_ENABLED=true
# TELEGRAMDOWNLOAD_WEB_SESSION_DAYS=7
# TELEGRAMDOWNLOAD_WEB_AUTH_SECURE_COOKIES=false
# TELEGRAMDOWNLOAD_APP_ID=
# TELEGRAMDOWNLOAD_API_HASH=
# TELEGRAMDOWNLOAD_BOT_TOKEN=
# TELEGRAMDOWNLOAD_CHAT_ID=

# ── Timezone (Linux TZ database name) ───────────────────────────────────────
TZ=
